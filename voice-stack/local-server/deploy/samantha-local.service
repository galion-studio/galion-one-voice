# Template only. Nothing in this tree installs it or starts it.
# Default socket is 127.0.0.1:7881 (galion-samantha-ws/1). Do not point this at 7878.
# Sandbox matches deploy/systemd/templates/galion-voice-stage.service:
# loopback bind, no new privileges, private tmp, strict filesystem, localhost only.
# Do not put GALION_SAMANTHA_REF, a key, or a public address in this file.
# A drop-in on the machine may set the reference path. This unit does not.

[Unit]
Description=Samantha local UI server (loopback)
After=network.target

[Service]
Type=simple
User=galion
ExecStart=/opt/galion/voice/local-server/samantha-local --ui /opt/galion/voice/local-server/ui
WorkingDirectory=/opt/galion/voice/local-server
Environment=GALION_SAMANTHA_WS=127.0.0.1:7881
Restart=on-failure
RestartSec=2
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=yes
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
