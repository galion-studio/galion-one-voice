# Development profile for the local host.
# Loaded only when GALION_HORBM_PROFILE=dev or --profile dev.
# No persona name selects this profile.
#
# GALION_HORBM_LEARN and GALION_HORBM_REMEMBER are left unset on purpose.
# In this profile an unset flag becomes grant. An operator value, including
# deny, still wins over that default. Outside this profile both stay off
# unless the operator sets grant.
#
# Leave the path keys unset so the platform data directory is used.
# A relative path is refused. Do not put secrets in this file.
#
# GALION_HORBM_DATA_ROOT=
# GALION_HORBM_MEMORY_DIR=
# GALION_HORBM_LEARN_PACK=
# GALION_HORBM_TURN_LOG=
# GALION_HORBM_TURN_LOG_CAP=8388608
