# Copy to ~/.config/galion/samantha-local.env and replace the placeholders.
# systemd EnvironmentFile format: one KEY=VALUE per line, then a comment line.
# supervise.sh accepts the same shape. No shell substitution.
# Placeholders are not paths on a machine. Keep the edited copy out of git.
# Values use letters, digits, and / . _ : + - @
# GALION_SAMANTHA_WS is numeric loopback. Any other bind is refused.

SAMANTHA_LOCAL_BIN=/path/to/samantha-local
GALION_SAMANTHA_UI=/path/to/ui
SAMANTHA_LOCAL_WORKDIR=/path/to/workdir
GALION_SAMANTHA_WS=127.0.0.1:7881
SAMANTHA_HEALTH_FAILS=3
SAMANTHA_HEALTH_INTERVAL=5
SAMANTHA_HEALTH_GRACE=10
SAMANTHA_HEALTH_TIMEOUT=2
SAMANTHA_RESTART_BACKOFF_SEC=2
SAMANTHA_RESTART_BACKOFF_MAX_SEC=30
SAMANTHA_STOP_GRACE=5
