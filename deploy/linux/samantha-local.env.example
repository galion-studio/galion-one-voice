# Copy to ~/.config/galion/samantha-local.env and replace the placeholders.
# systemd EnvironmentFile format: one KEY=VALUE per line, then a comment line.
# supervise.sh accepts the same shape. No shell substitution.
# Placeholders are not paths on a machine. Keep the edited copy out of git.
# Values use letters, digits, and / . _ : + - @
# GALION_VOICE_WS is numeric loopback. Any other bind is refused.
# GALION_SAMANTHA_WS and GALION_SAMANTHA_UI are deprecated fallbacks.
# Each logs one warning and names the new variable. The new value wins.

SAMANTHA_LOCAL_BIN=/path/to/samantha-local
GALION_VOICE_UI=/path/to/ui
SAMANTHA_LOCAL_WORKDIR=/path/to/workdir
GALION_VOICE_WS=127.0.0.1:7881
SAMANTHA_HEALTH_FAILS=3
SAMANTHA_HEALTH_INTERVAL=5
SAMANTHA_HEALTH_GRACE=10
SAMANTHA_HEALTH_TIMEOUT=2
SAMANTHA_RESTART_BACKOFF_SEC=2
SAMANTHA_RESTART_BACKOFF_MAX_SEC=30
# Seconds after SIGTERM before SIGKILL. The server uses that signal to drain,
# end the diary session, and seal. Default 5. Measure the close on the laptop
# before lowering it. The user unit TimeoutStopSec is 15, so keep this below 15.
SAMANTHA_STOP_GRACE=5

# Development profile placeholders. Commented so a copied file does not turn
# the profile on. Uncomment on the machine. No real path. No credential.
# GALION_HORBM_PROFILE=dev
# GALION_HORBM_DATA_ROOT=/path/to/horbm-data
# GALION_HORBM_TURN_LOG=/path/to/turns.jsonl
