{
  "version": 1,
  "notes": "Zero-shot CLAP text prompts for categories without trained SER classes. Multiple paraphrases per label; scores are max (or mean) similarity then softmax across labels.",
  "labels": {
    "love": ["a tender loving voice", "a warm affectionate speaking voice", "someone speaking with love and care"],
