{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galion-probe/probe-result.schema.json",
  "title": "Galion Voice probe result (G0 local / R0 VPS)",
  "type": "object",
  "required": ["schema_version","probe","hostname","arch","logical_cpus","simd","mem_total_kib","mem_available_kib",
               "bench_threads","stream_triad_gbs_1t","stream_triad_gbs_nt","bw_runs_gbs","bw_mean_gbs","bw_cv_pct",
               "gemv_f32_gflops_2048","gemv_f32_gflops_4096","thresholds","student_sizing","student_recommendation","g0"],
  "properties": {
    "schema_version": {"const": 1},
    "probe": {"type": "string", "pattern": "^galion-probe "},
    "hostname": {"type": "string"}, "kernel": {"type": "string"}, "arch": {"type": "string"},
    "cpu_model": {"type": "string"},
    "logical_cpus": {"type": "integer", "minimum": 1},
    "available_parallelism": {"type": "integer", "minimum": 1},
    "simd": {"type": "array", "items": {"type": "string"}},
    "caches": {"type": "array", "items": {"type": "string"}},
    "mem_total_kib": {"type": "integer", "minimum": 0},
    "mem_available_kib": {"type": "integer", "minimum": 0},
    "swap_total_kib": {"type": "integer", "minimum": 0},
    "bench_threads": {"type": "integer", "minimum": 1},
    "triad_array_mib": {"type": "integer", "minimum": 1},
    "stream_triad_gbs_1t": {"type": "number", "exclusiveMinimum": 0},
    "stream_triad_gbs_nt": {"type": "number", "exclusiveMinimum": 0},
    "bw_runs_gbs": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "bw_mean_gbs": {"type": "number", "exclusiveMinimum": 0},
    "bw_cv_pct": {"type": "number", "minimum": 0},
    "gemv_f32_gflops_2048": {"type": "number", "exclusiveMinimum": 0},
    "gemv_f32_gflops_4096": {"type": "number", "exclusiveMinimum": 0},
    "est_decode_tps_1b5_q8": {"type": "number"}, "est_decode_tps_1b5_q4": {"type": "number"},
    "gate_realtime_12_5hz_q4_1b5": {"enum": ["PASS","FAIL"]},
    "thresholds": {"type": "object",
      "required": ["locks","bw_cv_max_pct","bw_min_gbs_nt","frame_hz","realtime_headroom"]},
    "student_sizing": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["params_b","tps_q8","tps_q4","verdict"],
      "properties": {"verdict": {"enum": ["q8","q4","no"]}}}},
    "student_recommendation": {"type": "string", "pattern": "^(none|[0-9.]+B-q[48])$"},
    "g0": {"enum": ["PASS","FAIL"]}
  }
}
